# Supabase (server-side only; never prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: separate secret for signing the login cookie (defaults to ADMIN_PASSWORD)
# Admin login (/admin/login). Use a long random password.
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=

# Booking alerts to the owner (optional; each switches on when set)
# Email via Resend (free tier): sign up at resend.com with the alert address, create an API key
RESEND_API_KEY=
# Where alerts go (defaults to the site email, hello@astbal.in)
BOOKING_ALERT_EMAIL=
# After verifying astbal.in in Resend, e.g. "ASTBAL Bookings <bookings@astbal.in>"
RESEND_FROM=
# Telegram (free): create a bot with @BotFather, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
